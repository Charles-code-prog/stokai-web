# Turso → `turso db show stokai --url` e `turso db tokens create stokai`
# (ou criadas automaticamente pela integração Turso Cloud do Vercel)
TURSO_DATABASE_URL=libsql://stokai-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=

# Opcional: "false" bloqueia novos cadastros (deixe só a sua conta)
ALLOW_SIGNUP=true

# E-mails (Gmail com senha de app: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sem TURSO_DATABASE_URL, em desenvolvimento usa o arquivo local stokai-local.db
